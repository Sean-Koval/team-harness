+/* the theme's dark palette sets the link color per primary color, one step more specific than above */
+[data-md-color-scheme][data-md-color-primary] { --md-typeset-a-color: var(--af-fg); }
+
 body { background: var(--af-canvas); }
 .md-typeset { font-feature-settings: "kern"; }
 
 /* header and tabs: flat, with the product's 2px marker */
 .md-header, .md-tabs { background: var(--af-canvas); color: var(--af-fg); box-shadow: none; }
 .md-header { border-bottom: 1px solid var(--af-line); }
-.md-header__title { font-family: var(--af-f-display); font-stretch: var(--af-display-stretch); font-weight: var(--af-display-weight); letter-spacing: var(--af-display-track); }
+.md-header__title { font-family: var(--af-font-display); font-stretch: var(--af-display-stretch); font-weight: var(--af-display-weight); letter-spacing: var(--af-display-track); }
 .md-tabs { border-bottom: 1px solid var(--af-line); }
-.md-tabs__link { font-family: var(--af-f-mono); font-size: .62rem; letter-spacing: var(--af-label-track); text-transform: uppercase; opacity: 1; color: var(--af-fg-muted); }
+.md-tabs__link { font-family: var(--af-font-mono); font-size: .62rem; letter-spacing: var(--af-label-track); text-transform: uppercase; opacity: 1; color: var(--af-fg-muted); }
 .md-tabs__link--active, .md-tabs__link:hover { color: var(--af-fg); }
 .md-tabs__item--active { box-shadow: inset 0 -2px 0 var(--af-product); }
 .md-header::after { content: ""; position: absolute; left: 0; bottom: -1px; width: 48px; height: 2px; background: var(--af-product); }
 
