# The agent environment's variables (environments/agent.yaml): names only, never values. The same names are set in
# your shell for a local run (`make agent-env`) and are hangar credentials for a cloud session. `hangar env local`
# passes these names, and only these, into the container; scripts/check_registry.py fails when this list and the
# spec's `secrets` disagree. Copy it outside the repository if you keep values in a file; never commit one.

# Inputs: from git and the tracker, one run each.
TICKET_KEY=                   # the ticket the run works, e.g. KAN-123
CODE_REPO=                    # the code repo's clone URL (https)
KNOWLEDGE_REPO=               # the knowledge repo's clone URL (https)

# Credentials. Right of each name: where hangar takes it from. Every one is the agent's own identity, never a person's
# token (KAN-497): a GitHub App or bot account, and an Atlassian bot user or service account that is not on HANGAR_JIRA
# agent_release.people. `make agent-env` refuses an Atlassian account on that list (hangar's agent-identity.md).
GH_TOKEN=                     # secret github-agent: an App installation or bot token; clone, gh, ai-dlc's GitHub provider
GITHUB_MCP_AUTHORIZATION=     # secret github-mcp: "Bearer <token>" for the GitHub MCP server, the same bot identity
ATLASSIAN_MCP_AUTHORIZATION=  # secret atlassian-mcp: the agent account's "Basic <base64 email:token>" or "Bearer <key>"
# The model credential: set one. `make agent-env-check` fails, naming both, when neither is set (KAN-496).
CLAUDE_CODE_OAUTH_TOKEN=      # from `claude setup-token` (a subscription login); hangar's claude-code OAuth credential
ANTHROPIC_API_KEY=            # the alternative, billed to the API; hangar's claude-code API-key credential
