# Locks pin raw bytes (harness.lock digests, sync_shared.py --check), so the harness files keep LF on every checkout,
# Git for Windows' autocrlf included (KAN-460).
shared/** text=auto eol=lf
harnesses/** text=auto eol=lf
orgs/** text=auto eol=lf          # org skills are copied into harnesses byte for byte
templates/** text=auto eol=lf
