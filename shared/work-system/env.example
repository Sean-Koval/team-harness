# The session's environment contract for this harness: names only, never values. Set them in your shell or
# your secret store; hangar fills credentials from the names in bindings/<harness>.yaml. Copy this file outside the
# repository if you keep values in a file, and never commit one. tests/test_knowledge_skills.py fails when a name the
# harness binds is missing here.

# Knowledge: read by the ai-dlc MCP server (harness.lock binding `ai-dlc`) and the knowledge skills.
KNOWLEDGE_REPO=                  # the knowledge repository: a local clone or its clone URL
KNOWLEDGE_FORMAT_VERSION=        # the record format the session expects; must equal [format] version in knowledge.toml

# MCP servers this harness binds (harness.lock binding.mcp; bindings/<harness>.yaml).
{{session_env}}

# Tracker role, only when the project's ai-dlc.toml selects the jira-cloud provider. These are the names ai-dlc's
# docs use (docs/runbooks/jira-cloud-setup.md); the provider's token_env and email_env must name the same.
JIRA_WORK_ACCESS_TOKEN=          # auth_mode oauth_bearer
JIRA_WORK_API_TOKEN=             # auth_mode personal_scoped_token_basic, with JIRA_WORK_EMAIL
JIRA_WORK_EMAIL=

# Wiki role: the render job's credential, never a session's. Sessions never write the wiki; leave these unset here.
# CONFLUENCE_TOKEN=
# ATLASSIAN_EMAIL=
