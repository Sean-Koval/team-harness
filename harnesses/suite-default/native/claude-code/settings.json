{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Read(~/.git-credentials)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Suite harness: no edit before a ticket key (jira-ticket, work-start); questions for Sean become Decision tickets (decision-ticket); docs in the same PR (work-docs); PR title KEY: and Jira/Docs lines (github-pr). Agents never move tickets; merge your own PR only when checks are green and no review was asked for.'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/guard_work_system.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/knowledge_session_end.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
