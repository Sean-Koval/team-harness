{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm install:*)",
      "Bash(helm uninstall:*)",
      "Read(~/.kube/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Team default harness: start from the ticket (jira-ticket), spec behaviour changes (openspec-change), investigate read-only (splunk-logs, gke-diagnose), deliver one PR (github-pr).'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/guard_readonly.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
